# ---------------------------------------------------------------------------
# QuizArena web app (Next.js — admin portal, projector, player)
# Copy to apps/web/.env.local for local development. Never commit the real file.
# ---------------------------------------------------------------------------

# Server-side only: where /api/* is proxied (the game server's public URL).
# Read at build time by the rewrites in next.config.ts — set it before `next build`.
API_ORIGIN=http://localhost:4000

# Browser: where the realtime socket connects (usually the same game server URL).
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# Browser: canonical site URL used in join links and QR codes (e.g. https://quiz-arena.vercel.app).
# Falls back to the current origin when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
