# ---------------------------------------------------------------------------
# QuizArena game server (API + WebSocket + game engine)
# Copy to apps/server/.env for local development. Never commit the real file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Neon / Supabase / Railway / local).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quizarena

# Signs admin session cookies and socket tickets. Generate with: openssl rand -base64 48
# The server refuses to start in production with a value starting with "dev-only".
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef0123456789

# Comma-separated browser origins allowed by CORS / Socket.IO (your Vercel domain).
WEB_ORIGIN=http://localhost:3000

# Listen address. Railway/Render/Fly inject PORT automatically.
PORT=4000
HOST=0.0.0.0

# development | test | production
NODE_ENV=development

# Set to true when running behind a proxy/load balancer so client IPs (rate limits) are correct.
TRUST_PROXY=false

# Optional: enables the Socket.IO Redis adapter for multi-node fan-out.
# REDIS_URL=redis://localhost:6379

# Optional: allow self-service admin sign-up at POST /api/auth/register.
ALLOW_REGISTRATION=false

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Used by `pnpm db:seed` to create the first admin account and a sample quiz.
SEED_ADMIN_EMAIL=admin@quizarena.dev
SEED_ADMIN_PASSWORD=change-this-password
SEED_ADMIN_NAME=Arena Admin

# ---------------------------------------------------------------------------
# Image uploads (docs/MEDIA.md)
# ---------------------------------------------------------------------------
# local = files on this server's disk (development only: Render/Railway/Fly disks are wiped on
#         every deploy). s3 = any S3-compatible bucket (Cloudflare R2, Supabase Storage, AWS S3).
#         none = uploads off (organisers can still paste https:// image links).
# Default: s3 when S3_BUCKET is set, otherwise local in development and none in production.
# MEDIA_STORAGE=local
# MEDIA_LOCAL_DIR=./uploads
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=quizarena-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public base URL the bucket's objects are served from (r2.dev / custom domain / CDN):
# S3_PUBLIC_URL=https://media.example.com

# ---------------------------------------------------------------------------
# Google Drive image picker (docs/MEDIA.md → Google Drive). All three are required.
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" of the OAuth client:
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Optional: key for encrypting stored Google refresh tokens (default: derived from JWT_SECRET).
# GOOGLE_TOKEN_KEY=
