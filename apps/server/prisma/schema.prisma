// QuizArena data model.
//
// Live game state is held in memory by the game engine while a session runs; this schema
// stores everything that must survive it: content, sessions, participants, every accepted
// answer (with the server receipt time) and the final standings.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum QuizStatus {
  DRAFT
  PUBLISHED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum ScoringMode {
  SPEED
  ACCURACY
}

enum ReadingMode {
  OFF
  TIMED
  MANUAL
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ImageFit {
  CONTAIN
  COVER
}

enum ImagePosition {
  CENTER
  TOP
  BOTTOM
}

enum MediaSource {
  UPLOAD
  GOOGLE_DRIVE
}

enum SessionStatus {
  LOBBY
  LIVE
  FINISHED
  ABANDONED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  /// Embedded in session tokens; bumping it (password change) signs out every other device.
  sessionVersion Int    @default(0)
  /// Organiser defaults for new quizzes: { appearance?, quizDefaults? } (userPreferencesSchema).
  preferences  Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quizzes  Quiz[]
  sessions QuizSession[]
  media    MediaAsset[]
  google   GoogleAccount?
}

/// A connected Google account for picking images from Drive (read-only scope).
model GoogleAccount {
  userId       String   @id
  email        String
  /// AES-256-GCM encrypted refresh token; never returned by the API.
  refreshToken String
  scope        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Quiz {
  id            String     @id @default(cuid())
  ownerId       String
  title         String
  description   String     @default("")
  coverImageUrl String?
  status        QuizStatus @default(DRAFT)

  // Settings
  defaultTimerSec    Int         @default(20)
  scoringMode        ScoringMode @default(SPEED)
  streakBonus        Boolean     @default(true)
  randomizeQuestions Boolean     @default(false)
  randomizeAnswers   Boolean     @default(false)
  showLeaderboard    Boolean     @default(true)
  showCorrectAnswers Boolean     @default(true)
  showAnswerStats    Boolean     @default(true)
  allowLateJoin      Boolean     @default(false)
  participantLimit   Int         @default(200)
  soundEnabled       Boolean     @default(true)
  nicknameFilter     Boolean     @default(true)
  /// Reading period before answers open: none, a countdown, or until the host opens them.
  readingMode        ReadingMode @default(TIMED)
  readingTimeSec     Int         @default(5)
  /// Leaderboard after every Nth question (and always after the last); 1 = every question.
  leaderboardEvery   Int         @default(1)
  /// Seconds after time's up before the answers are shown automatically; 0 = the host decides.
  autoRevealSec      Int         @default(0)
  /// Arena appearance (theme, colours, typography, motion, layouts, branding).
  /// Validated by arenaAppearanceSchema; null means the defaults.
  appearance         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  questions Question[]
  sessions  QuizSession[]

  @@index([ownerId, updatedAt])
  @@index([ownerId, status])
}

model Question {
  id               String       @id @default(cuid())
  quizId           String
  order            Int
  type             QuestionType @default(MULTIPLE_CHOICE)
  text             String       @default("")
  /// The image shown with the question: a library asset's URL, or an external https link.
  imageUrl         String?
  imageAssetId     String?
  imageFit         ImageFit      @default(CONTAIN)
  imagePosition    ImagePosition @default(CENTER)
  /// null = use the quiz default timer
  timeLimitSec     Int?
  points           Int          @default(1000)
  explanation      String       @default("")
  randomizeAnswers Boolean      @default(false)
  /// Question bank metadata.
  tags             String[]     @default([])
  category         String       @default("")
  difficulty       Difficulty?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  quiz       Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  imageAsset MediaAsset?    @relation(fields: [imageAssetId], references: [id], onDelete: SetNull)
  options    AnswerOption[]

  @@index([quizId, order])
  @@index([imageAssetId])
}

/// An uploaded image. Only metadata lives here; the optimized files live in object storage
/// (or the local media folder in development) under `storageKey`.
model MediaAsset {
  id          String      @id @default(cuid())
  ownerId     String
  /// Display name, editable; never used as a file path.
  name        String
  storageKey  String      @unique
  /// Full-size optimized WebP (longest side at most 1920px).
  url         String
  /// Smaller renditions by width, e.g. { "960": url, "480": url }.
  variants    Json        @default("{}")
  /// A tiny (~24px) blurred preview as a data URI, for blur-up while the image loads.
  placeholder String      @default("")
  mimeType    String      @default("image/webp")
  /// Stored bytes across all renditions.
  bytes       Int
  width       Int
  height      Int
  source      MediaSource @default(UPLOAD)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([ownerId, createdAt])
}

model AnswerOption {
  id         String  @id @default(cuid())
  questionId String
  order      Int
  text       String  @default("")
  isCorrect  Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, order])
}

model QuizSession {
  id     String        @id @default(cuid())
  /// Human-readable join code. Unique among non-finished sessions (enforced by the engine).
  code   String
  quizId String?
  hostId String
  status SessionStatus @default(LOBBY)

  /// Frozen copy of the quiz (questions, options, settings) at session creation, so editing
  /// the quiz later never changes a past game's results.
  quizSnapshot Json
  quizTitle    String

  createdAt DateTime  @default(now())
  startedAt DateTime?
  endedAt   DateTime?

  quiz         Quiz?               @relation(fields: [quizId], references: [id], onDelete: SetNull)
  host         User                @relation(fields: [hostId], references: [id], onDelete: Cascade)
  participants Participant[]
  answers      ParticipantAnswer[]
  results      QuizResult[]

  @@index([code, status])
  @@index([hostId, createdAt])
  @@index([quizId])
}

model Participant {
  id          String   @id @default(cuid())
  sessionId   String
  nickname    String
  /// Lowercased nickname, unique per session.
  nicknameKey String
  /// SHA-256 of the reconnect token; the raw token only lives on the player's device.
  tokenHash   String
  joinedAt    DateTime @default(now())
  leftAt      DateTime?
  removed     Boolean  @default(false)

  session QuizSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers ParticipantAnswer[]
  result  QuizResult?

  @@unique([sessionId, nicknameKey])
  @@index([sessionId])
}

model ParticipantAnswer {
  id            String   @id @default(cuid())
  sessionId     String
  participantId String
  /// Question id from the session snapshot (not a FK: the source question may be deleted).
  questionId    String
  questionIndex Int
  optionId      String
  isCorrect     Boolean
  responseMs    Int
  points        Int
  /// Server receipt time — the authoritative timestamp for this answer.
  receivedAt    DateTime

  session     QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, questionId])
  @@index([sessionId, questionIndex])
}

model QuizResult {
  id             String @id @default(cuid())
  sessionId      String
  participantId  String @unique
  rank           Int
  score          Int
  correctCount   Int
  answeredCount  Int
  totalQuestions Int
  avgResponseMs  Int?
  bestStreak     Int

  session     QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([sessionId, rank])
}
