# Public configuration (safe in the browser: Row Level Security protects the data).
# From your Supabase project: Settings → API. For local development, `supabase start` prints both.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Private configuration (server only, never prefixed with NEXT_PUBLIC_).
# Optional: enables the AI gateway that rewrites explanations. Without it, everything still works.
ANTHROPIC_API_KEY=

# Never add the Supabase service-role key to this app. Nothing here needs it.
